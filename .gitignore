node_modules/
dist/
.turbo/
*.tsbuildinfo

# Der pnpm-Store liegt in dieser Umgebung im Projektverzeichnis (~310 MB).
.pnpm-store/

# Spike-Artefakte: Messergebnisse werden nach docs/spikes/ übernommen,
# die erzeugten Bilder und PDFs nicht.
spikes/out/

# Projektdaten und Caches
#
# `*.franibook` ist seit dem 18.08.2026 die Projektdatei selbst (vorher ein
# Verzeichnis dieses Namens): ein ganzer Buchstand samt Fotoliste. Wer eines
# davon zum Ausprobieren im Arbeitsverzeichnis ablegt, soll es nicht versehentlich
# einchecken — die Notanker daneben ebenso wenig.
*.franibook
*.franibook.history/
*.franibook/cache/
*.franibook.bak-*/

.DS_Store
*.log

# Laufzeit-Artefakte des Prototyps
.franibook-cache/
.franibook-out/
tests/parity/.cache/
tests/parity/.project-zuletzt.json
tests/parity/.project/
tests/parity/.out/
tests/parity/.artifacts/
tests/parity/.project/
test-results/
playwright-report/
apps/server/.franibook-cache/
apps/server/.franibook-out/
.franibook-project/
apps/server/.franibook-project/
apps/server/.franibook-project-probe/
apps/server/.franibook-project.bak-*/
# Arbeitskopien paralleler Agenten
.claude/worktrees/

entwuerfe/
